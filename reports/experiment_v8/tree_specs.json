{
  "E_mean_lux": {
    "target": "E_mean_lux",
    "family": "XGBoost",
    "transform": "log1p",
    "id": "depth3",
    "params": {
      "objective": "reg:squarederror",
      "tree_method": "hist",
      "device": "cpu",
      "n_estimators": 150,
      "learning_rate": 0.07,
      "min_child_weight": 100,
      "reg_lambda": 10.0,
      "subsample": 1.0,
      "colsample_bytree": 1.0,
      "n_jobs": 4,
      "random_state": 2026,
      "verbosity": 0,
      "max_depth": 3
    }
  },
  "E_P10_lux": {
    "target": "E_P10_lux",
    "family": "RandomForest",
    "transform": "relative",
    "id": "depth12",
    "params": {
      "n_estimators": 64,
      "max_features": 1.0,
      "bootstrap": true,
      "max_samples": 0.7,
      "n_jobs": 4,
      "random_state": 2026,
      "max_depth": 12,
      "min_samples_leaf": 100
    }
  },
  "F_UDI_fraction": {
    "target": "F_UDI_fraction",
    "family": "HistGB",
    "transform": "identity",
    "id": "v1_baseline",
    "params": {
      "loss": "squared_error",
      "learning_rate": 0.07,
      "max_iter": 150,
      "max_leaf_nodes": 15,
      "min_samples_leaf": 100,
      "l2_regularization": 10.0,
      "early_stopping": false,
      "random_state": 2026
    }
  }
}