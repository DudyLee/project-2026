# Public repository allowlist. Keep datasets, weights and run artifacts local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/METHODS.md
!/RESULTS.md
!/environment.yml
!/configs/
!/scripts/
!/results/
!/tests/
/configs/*
!/configs/study.json
!/configs/tree_parameters.json
/scripts/*
!/scripts/methods.py
!/scripts/train.py
!/scripts/check_results.py
/results/*
!/results/summary_metrics.csv
!/results/room_metrics.csv
!/results/history_mae.csv
/tests/*
!/tests/test_methods.py
__pycache__/
*.py[cod]
