{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tower A PVSD trial 0.1 input batch",
  "type": "array",
  "minItems": 1,
  "description": "Additional runtime checks: finite values, unit orientation vector, protected TEST identifiers. Units and conventions: docs/trial_v0_1_usage.md.",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "Room_Area_m2",
      "Glass_Area_m2",
      "Orientation_X_model",
      "Orientation_Y_model",
      "Solar_Obstruction_Ratio",
      "DOY_1based",
      "Hour",
      "EPW_GHI_Wh_m2",
      "EPW_DNI_Wh_m2",
      "EPW_DHI_Wh_m2",
      "Solar_Altitude_mid_deg",
      "Solar_Azimuth_mid_deg"
    ],
    "properties": {
      "Room_Area_m2": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "Glass_Area_m2": {
        "type": "number",
        "minimum": 0
      },
      "Orientation_X_model": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "Orientation_Y_model": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "Solar_Obstruction_Ratio": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "DOY_1based": {
        "type": "integer",
        "minimum": 1,
        "maximum": 365
      },
      "Hour": {
        "type": "integer",
        "minimum": 7,
        "maximum": 18
      },
      "EPW_GHI_Wh_m2": {
        "type": "number",
        "minimum": 0
      },
      "EPW_DNI_Wh_m2": {
        "type": "number",
        "minimum": 0
      },
      "EPW_DHI_Wh_m2": {
        "type": "number",
        "minimum": 0
      },
      "Solar_Altitude_mid_deg": {
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "Solar_Azimuth_mid_deg": {
        "type": "number",
        "minimum": 0,
        "maximum": 360
      },
      "Room_ID": {
        "type": "string"
      },
      "Request_ID": {
        "type": "string"
      }
    }
  }
}